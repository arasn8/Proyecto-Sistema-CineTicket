@model List<Asiento>
@{
    ViewData["Title"] = "Selecciona tu asiento";
    var funcion = (Funcione)ViewBag.Funcion;
    var ocupados = (List<int>)ViewBag.Ocupados;
    var filas = Model.Select(a => a.Fila).Distinct().OrderBy(f => f);
}
<h1 class="display-font" style="font-size:2.2rem;">@funcion.IdPeliculaNavigation.Titulo</h1>
<p class="poster-meta mb-4">SALA @funcion.IdSalaNavigation.Nombre · @funcion.Fecha.ToString("dd/MM/yyyy") · @funcion.Hora.ToString("HH:mm")</p>

<div class="screen-label">PANTALLA</div>
<div class="screen-arc"></div>

<div class="seat-grid mb-3">
@foreach (var fila in filas)
{
    <div class="d-flex gap-2">
    @foreach (var a in Model.Where(x => x.Fila == fila).OrderBy(x => x.Numero))
    {
        bool ocupado = ocupados.Contains(a.IdAsiento);
        <button type="button" class="seat-btn" id="asiento-@a.IdAsiento"
                onclick="agregarAsiento(@funcion.IdFuncion, @a.IdAsiento, this)"
                @(ocupado ? "disabled" : "")>@a.Fila@a.Numero</button>
    }
    </div>
}
</div>

<p id="carritoContador" class="text-center poster-meta mb-4"></p>

<div class="text-center">
    <a asp-controller="Carrito" asp-action="Index" class="btn btn-success px-4">Ver mi carrito</a>
</div>

@section Scripts {
<script>
    async function agregarAsiento(idFuncion, idAsiento, btn) {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const body = new URLSearchParams({ idFuncion, idAsiento });

        const res = await fetch('@Url.Action("AgregarAjax", "Carrito")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
            body
        });
        const data = await res.json();

        if (data.success) {
            btn.disabled = true;
            btn.classList.add('seat-added');
            mostrarToast(data.mensaje, 'success');
            document.getElementById('carritoContador').textContent = `${data.totalCarrito} asiento(s) en tu carrito`;
        } else {
            mostrarToast(data.mensaje, 'danger');
        }
    }
</script>
}