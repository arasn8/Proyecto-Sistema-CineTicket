@model List<Asiento>
@{
    ViewData["Title"] = "Selecciona tu asiento";
    var funcion = (Funcione)ViewBag.Funcion;
    var ocupados = (List<int>)ViewBag.Ocupados;
}
<h2>@funcion.IdPeliculaNavigation.Titulo</h2>
<p class="text-muted">Sala @funcion.IdSalaNavigation.Nombre — @funcion.Fecha.ToString("dd/MM/yyyy") @funcion.Hora.ToString("HH:mm")</p>

<div class="d-flex flex-wrap gap-2 my-4">
@foreach (var a in Model)
{
    bool ocupado = ocupados.Contains(a.IdAsiento);
    <form asp-controller="Carrito" asp-action="Agregar" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="idFuncion" value="@funcion.IdFuncion" />
        <input type="hidden" name="idAsiento" value="@a.IdAsiento" />
        <button type="submit" class="btn @(ocupado ? "btn-secondary disabled" : "btn-outline-primary")" style="width:50px" @(ocupado ? "disabled" : "")>
            @a.Fila@a.Numero
        </button>
    </form>
}
</div>

<a asp-controller="Carrito" asp-action="Index" class="btn btn-success">Ver mi carrito</a>