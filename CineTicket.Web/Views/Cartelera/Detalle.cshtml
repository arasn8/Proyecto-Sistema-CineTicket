@model Pelicula
@{
    ViewData["Title"] = Model.Titulo;
    var funciones = (List<Funcione>)ViewBag.Funciones;
    var fechas = (List<DateOnly>)ViewBag.FechasDisponibles;
    var fechaSel = (DateOnly)ViewBag.FechaSeleccionada;
    var formatosPorFecha = (Dictionary<DateOnly, List<string>>)ViewBag.FormatosPorFecha;
    var formatosDelDia = (List<string>)ViewBag.FormatosDelDia;
}
<div class="row">
    <div class="col-md-4">
        @if (!string.IsNullOrEmpty(Model.ImagenUrl))
        {
            <img src="@Model.ImagenUrl" class="img-fluid rounded" style="border:1px solid var(--line)" />
        }
    </div>
    <div class="col-md-8">
        <h1 class="display-font" style="font-size:2.6rem;border:none;margin-bottom:0.3rem;">@Model.Titulo</h1>
        <div class="d-flex flex-wrap gap-1 mb-2">
            <span class="badge-genre">@Model.IdGeneroNavigation?.Nombre</span>
            <span class="badge-genre">@Model.Clasificacion</span>
            <span class="badge-genre">@Model.Idioma</span>
        </div>
        <span class="poster-meta">@Model.DuracionMin MIN</span>
        <p class="mt-3" style="color:var(--text-muted)">@Model.Sinopsis</p>

        <h4 class="display-font mt-4" style="font-size:1.4rem;border:none;">Elige la fecha</h4>

        @if (!fechas.Any())
        {
            <p class="text-muted">No hay funciones programadas por el momento.</p>
        }
        else
        {
            <div class="calendar-strip mb-3">
            @foreach (var f in fechas)
            {
                var formatosEseDia = formatosPorFecha.ContainsKey(f) ? formatosPorFecha[f] : new List<string>();
                <a asp-action="Detalle" asp-route-id="@Model.IdPelicula" asp-route-fecha="@f.ToString("yyyy-MM-dd")"
                   class="calendar-day @(f == fechaSel ? "active" : "")">
                    <span class="calendar-dow">@f.ToDateTime(TimeOnly.MinValue).ToString("ddd").ToUpper()</span>
                    <span class="calendar-num">@f.Day</span>
                    <span class="calendar-formatos">@string.Join(" · ", formatosEseDia)</span>
                </a>
            }
            </div>

            <div class="mb-4">
                <label class="form-label">Formato disponible este día</label>
                <div class="d-flex gap-2">
                    <a asp-action="Detalle" asp-route-id="@Model.IdPelicula" asp-route-fecha="@fechaSel.ToString("yyyy-MM-dd")"
                       class="btn btn-sm @(ViewBag.TipoSalaSeleccionado == null ? "btn-primary" : "btn-outline-secondary")">Todos</a>
                    @foreach (var tipo in formatosDelDia)
                    {
                        <a asp-action="Detalle" asp-route-id="@Model.IdPelicula" asp-route-fecha="@fechaSel.ToString("yyyy-MM-dd")" asp-route-tipoSala="@tipo"
                           class="btn btn-sm @(ViewBag.TipoSalaSeleccionado?.ToString() == tipo ? "btn-primary" : "btn-outline-secondary")">@tipo</a>
                    }
                </div>
                @if (!formatosDelDia.Any())
                {
                    <p class="poster-meta mt-2">No hay formatos disponibles para esta fecha.</p>
                }
            </div>

            @if (!funciones.Any())
            {
                <p class="text-muted">No hay funciones con ese formato para la fecha elegida.</p>
            }
            <div class="d-flex flex-column gap-2">
            @foreach (var f in funciones)
            {
                <a asp-controller="Cartelera" asp-action="Asientos" asp-route-idFuncion="@f.IdFuncion" class="ticket text-decoration-none">
                    <div class="ticket-main d-flex justify-content-between align-items-center">
                        <div>
                            <div class="ticket-title">@f.Hora.ToString("HH:mm")</div>
                            <div class="ticket-info">Sala @f.IdSalaNavigation?.Nombre · @f.IdSalaNavigation?.Tipo</div>
                        </div>
                        <div class="ticket-price">S/ @f.PrecioEntrada</div>
                    </div>
                    <div class="ticket-stub">ELEGIR<br />ASIENTO</div>
                </a>
            }
            </div>
        }
    </div>
</div>