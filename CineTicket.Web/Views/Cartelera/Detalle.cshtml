@model Pelicula
@{
    ViewData["Title"] = Model.Titulo;
    var funciones = (List<Funcione>)ViewBag.Funciones;
}
<div class="row">
    <div class="col-md-4 mb-4">
        @if (!string.IsNullOrEmpty(Model.ImagenUrl))
        {
            <img src="@Model.ImagenUrl" class="img-fluid rounded" style="border:1px solid var(--line)" />
        }
    </div>
    <div class="col-md-8">
        <h1 class="display-font" style="font-size:2.6rem;border:none;margin-bottom:0.3rem;">@Model.Titulo</h1>
        <span class="badge-genre">@Model.IdGeneroNavigation?.Nombre</span>
        <span class="poster-meta ms-2">@Model.DuracionMin MIN · @Model.Clasificacion</span>
        <p class="mt-3" style="color:var(--text-muted)">@Model.Sinopsis</p>

        <h4 class="display-font mt-4" style="font-size:1.4rem;border:none;">Funciones disponibles</h4>
        @if (!funciones.Any())
        {
            <p class="text-muted">No hay funciones programadas por el momento.</p>
        }
        <div class="d-flex flex-column gap-2 mt-3">
        @foreach (var f in funciones)
        {
            <a asp-controller="Cartelera" asp-action="Asientos" asp-route-idFuncion="@f.IdFuncion"
               class="ticket text-decoration-none">
                <div class="ticket-main d-flex justify-content-between align-items-center">
                    <div>
                        <div class="ticket-title">@f.Fecha.ToString("dd MMM").ToUpper()</div>
                        <div class="ticket-info">@f.Hora.ToString("HH:mm") · Sala @f.IdSalaNavigation?.Nombre</div>
                    </div>
                    <div class="ticket-price">S/ @f.PrecioEntrada</div>
                </div>
                <div class="ticket-stub">ELEGIR<br />ASIENTO</div>
            </a>
        }
        </div>
    </div>
</div>