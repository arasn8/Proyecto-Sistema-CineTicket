<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CineTicket</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
    href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body>
    <form id="antiForgeryForm" style="display:none">@Html.AntiForgeryToken()</form>
    <div id="toastContainer"></div>

    <!-- OFFCANVAS DE AUTENTICACIÓN (independiente, hermano del modal, NO anidado) -->
    <div class="offcanvas offcanvas-end auth-panel" tabindex="-1" id="authPanel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title display-font" style="letter-spacing:0.04em;">Mi cuenta</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body">
            <ul class="nav nav-pills auth-tabs mb-4">
                <li class="nav-item flex-fill">
                    <button type="button" class="nav-link w-100 active" onclick="mostrarAuthTab('pane-login', this)">Iniciar sesión</button>
                </li>
                <li class="nav-item flex-fill">
                    <button type="button" class="nav-link w-100" onclick="mostrarAuthTab('pane-register', this)">Registrarse</button>
                </li>
            </ul>

            <div id="authFeedback"></div>

            <!-- LOGIN -->
            <div id="pane-login" class="auth-pane">
                <form id="formLogin" onsubmit="return enviarLogin(event)">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Correo</label>
                        <input type="email" name="correo" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Contraseña</label>
                        <input type="password" name="clave" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100 mb-2">Ingresar</button>
                    <button type="button" class="btn btn-link btn-sm p-0" onclick="mostrarAuthTab('pane-forgot')">¿Olvidaste tu contraseña?</button>
                </form>
            </div>

            <!-- REGISTRO -->
            <div id="pane-register" class="auth-pane" style="display:none">
                <form id="formRegister" onsubmit="return enviarRegistro(event)">
                    @Html.AntiForgeryToken()
                    <div class="mb-3"><label class="form-label">Nombres</label><input name="Nombres" class="form-control" required /></div>
                    <div class="mb-3"><label class="form-label">Apellidos</label><input name="Apellidos" class="form-control" required /></div>
                    <div class="mb-3"><label class="form-label">Correo</label><input type="email" name="Correo" class="form-control" required /></div>
                    <div class="mb-3"><label class="form-label">Contraseña</label><input type="password" name="Clave" class="form-control" required minlength="6" /></div>
                    <div class="mb-3"><label class="form-label">Confirmar contraseña</label><input type="password" name="ConfirmarClave" class="form-control" required minlength="6" /></div>
                    <button type="submit" class="btn btn-primary w-100">Registrarme</button>
                </form>
            </div>

            <!-- OLVIDE MI CONTRASEÑA -->
            <div id="pane-forgot" class="auth-pane" style="display:none">
                <p class="poster-meta mb-3">Ingresa tu correo y te enviaremos un código de verificación.</p>
                <form id="formForgot" onsubmit="return enviarForgot(event)">
                    @Html.AntiForgeryToken()
                    <div class="mb-3"><label class="form-label">Correo</label><input type="email" name="correo" id="forgotCorreo" class="form-control" required /></div>
                    <button type="submit" class="btn btn-primary w-100">Enviar código</button>
                </form>

                <form id="formReset" onsubmit="return enviarReset(event)" style="display:none; border-top:1px solid var(--line);" class="mt-4 pt-4">
                    @Html.AntiForgeryToken()
                    <div class="mb-3"><label class="form-label">Código de verificación</label><input name="codigo" class="form-control" required maxlength="6" /></div>
                    <div class="mb-3"><label class="form-label">Nueva contraseña</label><input type="password" name="nuevaClave" class="form-control" required minlength="6" /></div>
                    <button type="submit" class="btn btn-success w-100">Restablecer contraseña</button>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL DE CONFIRMACIÓN (independiente, hermano del offcanvas, NO anidado) -->
    <div class="modal fade" id="modalConfirmar" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content cine-modal">
                <div class="modal-body text-center py-4">
                    <p class="mb-4" id="modalConfirmarTexto" style="font-size:1.05rem;"></p>
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-success" id="modalConfirmarBtn">Sí, eliminar</button>
                </div>
            </div>
        </div>
    </div>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-cine">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <img src="~/img/CineT.png" alt="CineTicket" style="height:80px;width:auto;" />
                    <span>CineTicket</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Cartelera" asp-action="Index">Cartelera</a></li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Carrito" asp-action="Index">🛒 Mi carrito</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="MisCompras" asp-action="Index">🎟️ Mis boletos</a></li>
                        }
                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Administración</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Peliculas" asp-action="Index">Películas</a></li>
                                    <li><a class="dropdown-item" asp-controller="Generos" asp-action="Index">Géneros</a></li>
                                    <li><a class="dropdown-item" asp-controller="Salas" asp-action="Index">Salas</a></li>
                                    <li><a class="dropdown-item" asp-controller="Funciones" asp-action="Index">Funciones</a></li>
                                    <li><a class="dropdown-item" asp-controller="Usuarios" asp-action="Index">Usuarios</a></li>
                                    <li><a class="dropdown-item" asp-controller="Reportes" asp-action="Ventas">Reportes</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item"><span class="nav-link text-white-50">Hola, @User.Identity.Name</span></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Logout">Salir</a></li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <button class="btn btn-primary btn-sm" data-bs-toggle="offcanvas"
                                        data-bs-target="#authPanel">Ingresar</button>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container my-4">
        @if (TempData["Ok"] != null)
        {
            <div class="alert alert-success">@TempData["Ok"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="row py-5 gy-4">
                <div class="col-6 col-md-3">
                    <h6 class="footer-heading">Cines</h6>
                    <a asp-controller="Cartelera" asp-action="Index" class="footer-link">Cartelera</a>
                    <a asp-controller="Salas" asp-action="Index" class="footer-link">Nuestras salas</a>
                </div>
                <div class="col-6 col-md-3">
                    <h6 class="footer-heading">Cuenta</h6>
                    <a asp-controller="Account" asp-action="Login" class="footer-link">Iniciar sesión</a>
                    <a asp-controller="Account" asp-action="Register" class="footer-link">Registrarse</a>
                    <a asp-controller="MisCompras" asp-action="Index" class="footer-link">Mis boletos</a>
                </div>
                <div class="col-6 col-md-3">
                    <h6 class="footer-heading">Ayuda</h6>
                    <a href="#" class="footer-link">Preguntas frecuentes</a>
                    <a href="#" class="footer-link">Términos y condiciones</a>
                    <a href="#" class="footer-link">Política de privacidad</a>
                </div>
                <div class="col-6 col-md-3">
                    <h6 class="footer-heading">Contacto</h6>
                    <span class="footer-link">Book by phone: 0800 345 123</span>
                    <span class="footer-link">contacto@cineticket.com</span>
                </div>
            </div>
            <div class="footer-bottom py-3 text-center">
                &copy; @DateTime.Now.Year - CineTicket - Proyecto Desarrollo de Servicios Web I
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>