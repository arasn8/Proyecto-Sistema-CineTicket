<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CineTicket</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
    href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body>
    <form id="antiForgeryForm" style="display:none">@Html.AntiForgeryToken()</form>
    <div id="toastContainer"></div>

    
    <div class="offcanvas offcanvas-end auth-panel" tabindex="-1" id="authPanel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title display-font" style="letter-spacing:0.04em;">Mi cuenta</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body">
            <ul class="nav nav-pills auth-tabs mb-4">
                <li class="nav-item flex-fill">
                    <button type="button" class="nav-link w-100 active" onclick="mostrarAuthTab('pane-login', this)">Iniciar sesión</button>
                </li>
                <li class="nav-item flex-fill">
                    <button type="button" class="nav-link w-100" onclick="mostrarAuthTab('pane-register', this)">Registrarse</button>
                </li>
            </ul>

            <div id="authFeedback"></div>

            <!-- LOGIN -->
            <div id="pane-login" class="auth-pane">
                <form id="formLogin" method="post" onsubmit="return enviarLogin(event)">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Correo</label>
                        <input type="email" name="correo" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Contraseña</label>
                        <input type="password" name="clave" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100 mb-2">Ingresar</button>
                    <button type="button" class="btn btn-link btn-sm p-0" onclick="mostrarAuthTab('pane-forgot')">¿Olvidaste tu contraseña?</button>
                </form>
            </div>

            <!-- REGISTRO -->
            <div id="pane-register" class="auth-pane" style="display:none">
                <form id="formRegister" method="post" onsubmit="return enviarRegistro(event)">
                    @Html.AntiForgeryToken()
                    <div class="mb-3"><label class="form-label">Nombres</label><input name="Nombres" class="form-control" required /></div>
                    <div class="mb-3"><label class="form-label">Apellidos</label><input name="Apellidos" class="form-control" required /></div>
                    <div class="mb-3"><label class="form-label">Correo</label><input type="email" name="Correo" class="form-control" required /></div>
                    <div class="mb-3"><label class="form-label">Contraseña</label><input type="password" name="Clave" class="form-control" required minlength="6" /></div>
                    <div class="mb-3"><label class="form-label">Confirmar contraseña</label><input type="password" name="ConfirmarClave" class="form-control" required minlength="6" /></div>
                    <button type="submit" class="btn btn-primary w-100">Registrarme</button>
                </form>
            </div>

            <!-- OLVIDE MI CONTRASEÑA -->
            <div id="pane-forgot" class="auth-pane" style="display:none">
                <p class="poster-meta mb-3">Ingresa tu correo y te enviaremos un código de verificación.</p>
                <form id="formForgot" method="post" onsubmit="return enviarForgot(event)">
                    @Html.AntiForgeryToken()
                    <div class="mb-3"><label class="form-label">Correo</label><input type="email" name="correo" id="forgotCorreo" class="form-control" required /></div>
                    <button type="submit" class="btn btn-primary w-100">Enviar código</button>
                </form>

                <form id="formReset" method="post" onsubmit="return enviarReset(event)" style="display:none; border-top:1px solid var(--line);" class="mt-4 pt-4">
                    @Html.AntiForgeryToken()
                    <div class="mb-3"><label class="form-label">Código de verificación</label><input name="codigo" class="form-control" required maxlength="6" /></div>
                    <div class="mb-3"><label class="form-label">Nueva contraseña</label><input type="password" name="nuevaClave" class="form-control" required minlength="6" /></div>
                    <button type="submit" class="btn btn-success w-100">Restablecer contraseña</button>
                </form>
            </div>
        </div>
    </div>

   
    <div class="modal fade" id="modalConfirmar" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content cine-modal">
                <div class="modal-body text-center py-4">
                    <p class="mb-4" id="modalConfirmarTexto" style="font-size:1.05rem;"></p>
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-success" id="modalConfirmarBtn">Sí, eliminar</button>
                </div>
            </div>
        </div>
    </div>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-cine">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <img src="~/img/CineT.png" alt="CineTicket" style="height:80px;width:auto;" />
                    <span>CineTicket</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Cartelera" asp-action="Index">Cartelera</a></li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Carrito" asp-action="Index">🛒 Mi carrito</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="MisCompras" asp-action="Index">🎟️ Mis boletos</a></li>
                        }
                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Administración</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Peliculas" asp-action="Index">Películas</a></li>
                                    <li><a class="dropdown-item" asp-controller="Generos" asp-action="Index">Géneros</a></li>
                                    <li><a class="dropdown-item" asp-controller="Salas" asp-action="Index">Salas</a></li>
                                    <li><a class="dropdown-item" asp-controller="Funciones" asp-action="Index">Funciones</a></li>
                                    <li><a class="dropdown-item" asp-controller="Usuarios" asp-action="Index">Usuarios</a></li>
                                    <li><a class="dropdown-item" asp-controller="Reportes" asp-action="Ventas">Reportes</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item"><span class="nav-link text-white-50">Hola, @User.Identity.Name</span></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Logout">Salir</a></li>
                        }
                        else
{
    var esPaginaLogin = ViewContext.RouteData.Values["controller"]?.ToString() == "Account"
        && ViewContext.RouteData.Values["action"]?.ToString() == "Login";

    if (!esPaginaLogin)
    {
        <li class="nav-item">
            <button class="btn btn-primary btn-sm" data-bs-toggle="offcanvas"
                    data-bs-target="#authPanel">Ingresar</button>
        </li>
    }
}
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container my-4">
        @if (TempData["Ok"] != null)
        {
            <div class="alert alert-success">@TempData["Ok"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
    <div class="container">
        <div class="row py-5 gy-4">
            <div class="col-12 col-md-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="footer-logo-icon">🎬</span>
                    <span class="display-font footer-brand">CineTicket</span>
                </div>
                <p class="footer-tagline">Tu cine de siempre, ahora también en línea. Reserva tu entrada en segundos y vive la experiencia CineTicket.</p>
                <div class="d-flex gap-2 mt-3">
                    <a href="#" class="social-icon" aria-label="Facebook" title="Facebook">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.86c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.87h2.78l-.44 2.91h-2.34V22c4.78-.76 8.44-4.92 8.44-9.94Z"/></svg>
                    </a>
                    <a href="#" class="social-icon" aria-label="Instagram" title="Instagram">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.55.22.95.47 1.37.89.42.42.67.82.89 1.37.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.55-.47.95-.89 1.37-.42.42-.82.67-1.37.89-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.55-.22-.95-.47-1.37-.89-.42-.42-.67-.82-.89-1.37-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.55.47-.95.89-1.37.42-.42.82-.67 1.37-.89.42-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07M12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63c-.79.31-1.46.72-2.13 1.38C1.35 2.68.94 3.35.63 4.14c-.3.76-.5 1.64-.56 2.91C.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.31.79.72 1.46 1.38 2.13.67.66 1.34 1.07 2.13 1.38.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56.79-.31 1.46-.72 2.13-1.38.66-.67 1.07-1.34 1.38-2.13.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91-.31-.79-.72-1.46-1.38-2.13C21.32 1.35 20.65.94 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0Zm0 5.84A6.16 6.16 0 1 0 18.16 12 6.16 6.16 0 0 0 12 5.84Zm0 10.16A4 4 0 1 1 16 12a4 4 0 0 1-4 4Zm6.4-10.4a1.44 1.44 0 1 1-1.44-1.44 1.44 1.44 0 0 1 1.44 1.44Z"/></svg>
                    </a>
                    <a href="#" class="social-icon" aria-label="TikTok" title="TikTok">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M16.6 5.82s.51.5 0 0A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5c-1.42 0-2.6-1.16-2.6-2.6 0-1.72 1.66-3.02 3.37-2.48V9.66c-3.45-.46-6.47 2.22-6.47 5.64 0 3.33 2.76 5.7 5.69 5.7 3.15 0 5.69-2.55 5.69-5.7V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3s-1.88.09-3.24-1.48Z"/></svg>
                    </a>
                    <a href="#" class="social-icon" aria-label="YouTube" title="YouTube">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 6.2a3.02 3.02 0 0 0-2.12-2.14C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.38.56A3.02 3.02 0 0 0 .5 6.2 31.6 31.6 0 0 0 0 12a31.6 31.6 0 0 0 .5 5.8 3.02 3.02 0 0 0 2.12 2.14C4.5 20.5 12 20.5 12 20.5s7.5 0 9.38-.56a3.02 3.02 0 0 0 2.12-2.14A31.6 31.6 0 0 0 24 12a31.6 31.6 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.4 3.6Z"/></svg>
                    </a>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <h6 class="footer-heading">Cines</h6>
                <a asp-controller="Cartelera" asp-action="Index" class="footer-link">Cartelera</a>
            </div>
      <div class="col-6 col-md-2">
    <h6 class="footer-heading">Cuenta</h6>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <a asp-controller="MisCompras" asp-action="Index" class="footer-link">Mis boletos</a>
        <a asp-controller="Carrito" asp-action="Index" class="footer-link">Mi carrito</a>
        <a asp-controller="Account" asp-action="Logout" class="footer-link">Cerrar sesión</a>
    }
    else
    {
        <a href="#" class="footer-link" data-bs-toggle="offcanvas" data-bs-target="#authPanel">Iniciar sesión</a>
        <a href="#" class="footer-link" data-bs-toggle="offcanvas" data-bs-target="#authPanel">Registrarse</a>
    }
</div>
            <div class="col-6 col-md-2">
                <h6 class="footer-heading">Ayuda</h6>
                <a href="#" class="footer-link">Preguntas frecuentes</a>
                <a href="#" class="footer-link">Términos y condiciones</a>
                <a href="#" class="footer-link">Política de privacidad</a>
            </div>
            <div class="col-6 col-md-2">
                <h6 class="footer-heading">Contacto</h6>
                <span class="footer-link">📞 0800 345 123</span>
                <span class="footer-link">✉️ contacto@cineticket.com</span>
            </div>
        </div>
        <div class="footer-bottom py-3 d-flex justify-content-between flex-wrap gap-2">
            <span>&copy; @DateTime.Now.Year CineTicket — Todos los derechos reservados</span>
            <span>Hecho con 🎬 para los amantes del cine</span>
        </div>
    </div>
</footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>