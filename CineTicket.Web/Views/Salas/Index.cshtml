@model List<Sala>
@{
    ViewData["Title"] = "Salas";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Salas</h2>
    <a asp-action="Create" class="btn btn-primary">+ Nueva sala</a>
</div>
<table class="table table-striped">
    <thead><tr><th>Nombre</th><th>Capacidad</th><th>Tipo</th><th></th></tr></thead>
    <tbody>
    @foreach (var s in Model)
    {
        <tr id="fila-sala-@s.IdSala">
            <td>@s.Nombre</td>
            <td>@s.Capacidad</td>
            <td>@s.Tipo</td>
            <td class="text-end">
                <a asp-action="Edit" asp-route-id="@s.IdSala" class="btn btn-sm btn-outline-secondary">Editar</a>
                <button type="button" class="btn btn-sm btn-outline-danger"
                        onclick="eliminarRegistro('@Url.Action("EliminarAjax")/@s.IdSala', 'fila-sala-@s.IdSala', '¿Eliminar esta sala?')">
                    Eliminar
                </button>
            </td>
        </tr>
    }
    </tbody>
</table>