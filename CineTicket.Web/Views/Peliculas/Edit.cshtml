@using Microsoft.AspNetCore.Mvc.Rendering
@model Pelicula
@{
    ViewData["Title"] = "Editar Película";
}
<h2>Editar película</h2>
<form asp-action="Edit" asp-route-id="@Model.IdPelicula" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="IdPelicula" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label class="form-label">Título</label>
        <input asp-for="Titulo" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Sinopsis</label>
        <textarea asp-for="Sinopsis" class="form-control" rows="3"></textarea>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label class="form-label">Duración (min)</label>
            <input asp-for="DuracionMin" type="number" class="form-control" required />
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">Clasificación</label>
            <input asp-for="Clasificacion" class="form-control" required />
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">Género</label>
            <select asp-for="IdGenero" class="form-select" asp-items="@(new SelectList(ViewBag.Generos, "IdGenero", "Nombre"))" required></select>
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">URL de imagen (poster)</label>
        <input asp-for="ImagenUrl" class="form-control" />
    </div>
    <div class="form-check mb-3">
        <input asp-for="Estado" class="form-check-input" type="checkbox" />
        <label class="form-check-label">Activa</label>
    </div>
    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>