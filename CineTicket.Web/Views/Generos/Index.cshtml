@model List<Genero>
@{
    ViewData["Title"] = "Géneros";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Géneros</h2>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo género</a>
</div>
<table class="table table-striped">
    <thead><tr><th>Nombre</th><th></th></tr></thead>
    <tbody>
    @foreach (var g in Model)
    {
        <tr id="fila-genero-@g.IdGenero">
            <td>@g.Nombre</td>
            <td class="text-end">
                <a asp-action="Edit" asp-route-id="@g.IdGenero" class="btn btn-sm btn-outline-secondary">Editar</a>
                <button type="button" class="btn btn-sm btn-outline-danger"
                        onclick="eliminarRegistro('@Url.Action("EliminarAjax")/@g.IdGenero', 'fila-genero-@g.IdGenero', '¿Eliminar este género?')">
                    Eliminar
                </button>
            </td>
        </tr>
    }
    </tbody>
</table>
           