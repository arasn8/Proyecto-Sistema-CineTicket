@model List<Pelicula>
@{
    ViewData["Title"] = "Bienvenido";
}

<div class="text-center mb-4">
    <div class="badge-genre mb-2" style="font-size:0.85rem;">AHORA EN CARTELERA</div>
    <h1 class="display-font" style="font-size:3rem;">Bienvenido a CineTicket</h1>
    <p class="text-muted">Reserva tu entrada en segundos</p>
</div>

@if (Model.Any())
{
    <div id="carruselEstrenos" class="carousel slide hero-carousel mb-5" data-bs-ride="carousel">

        @if (Model.Count > 1)
        {
            <div class="carousel-indicators">
                @for (int i = 0; i < Model.Count; i++)
                {
                    <button type="button" data-bs-target="#carruselEstrenos" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")"></button>
                }
            </div>
        }

        <div class="carousel-inner">
            @for (int i = 0; i < Model.Count; i++)
            {
                var p = Model[i];
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    @if (!string.IsNullOrEmpty(p.ImagenUrl))
                    {
                        <img src="@p.ImagenUrl" class="d-block w-100 hero-slide-img" />
                    }
                    else
                    {
                        <div class="hero-slide-img d-flex align-items-center justify-content-center">
                            <span class="display-font" style="font-size:2.5rem;color:var(--line);">CineTicket</span>
                        </div>
                    }
                    <div class="carousel-caption">
                        <span class="badge-genre">@p.IdGeneroNavigation?.Nombre</span>
                        <h2 class="display-font mt-2" style="font-size:2.4rem;border:none;">@p.Titulo</h2>
                        <p class="poster-meta mb-3">@p.DuracionMin MIN · @p.Clasificacion</p>
                        <a asp-controller="Cartelera" asp-action="Detalle" asp-route-id="@p.IdPelicula" class="btn btn-primary px-4">Ver funciones</a>
                    </div>
                </div>
            }
        </div>

        @if (Model.Count > 1)
        {
            <button class="carousel-control-prev" type="button" data-bs-target="#carruselEstrenos" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carruselEstrenos" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
        }
    </div>
}
else
{
    <p class="text-muted text-center">Aún no hay películas registradas.</p>
}
<div class="quick-booking-bar mb-5">
    <div class="row g-2 align-items-center">
        <div class="col-md-9">
            <select id="quickBookingSelect" class="form-select">
                <option value="">Elige una película para reservar...</option>
                @foreach (var p in (List<Pelicula>)ViewBag.TodasPeliculas)
                {
                    <option value="@p.IdPelicula">@p.Titulo</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <button type="button" class="btn btn-primary w-100" onclick="var s=document.getElementById('quickBookingSelect'); if(s.value) location.href='/Cartelera/Detalle/'+s.value;">
                Buscar funciones
            </button>
        </div>
    </div>
</div>

<h2 class="display-font mb-3" style="font-size:1.8rem;border:none;">Top películas</h2>
<div class="film-strip mb-5">
@foreach (var p in (List<Pelicula>)ViewBag.TopPeliculas)
{
    <a asp-controller="Cartelera" asp-action="Detalle" asp-route-id="@p.IdPelicula" class="film-strip-item">
        @if (!string.IsNullOrEmpty(p.ImagenUrl))
        {
            <img src="@p.ImagenUrl" />
        }
        else
        {
            <div class="film-strip-placeholder">CineTicket</div>
        }
        <div class="film-strip-title">@p.Titulo</div>
    </a>
}
</div>
<div class="text-center">
    <a asp-controller="Cartelera" asp-action="Index" class="btn btn-outline-primary px-4">Ver toda la cartelera</a>
</div>