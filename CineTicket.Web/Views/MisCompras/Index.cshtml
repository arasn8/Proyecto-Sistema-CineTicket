@model List<FuncionCompradaVM>
@{
    ViewData["Title"] = "Mis boletos";
    var pendientes = (List<Venta>)ViewBag.Pendientes;
}
<h1 class="display-font" style="font-size:2.2rem;">Mis boletos</h1>

@if (pendientes.Any())
{
    <div class="alert alert-warning d-flex justify-content-between align-items-center">
        <span>Tienes @pendientes.Count compra(s) pendiente(s) de confirmar.</span>
        <a asp-controller="Carrito" asp-action="Espera" asp-route-id="@pendientes.First().IdVenta" class="btn btn-sm btn-primary">Completar pago</a>
    </div>
}

@if (!Model.Any())
{
    <p class="text-muted mt-3">Aún no tienes compras confirmadas.</p>
    <a asp-controller="Cartelera" asp-action="Index" class="btn btn-primary">Ver cartelera</a>
}
else
{
    @foreach (var fc in Model)
    {
        <div class="ticket mb-3">
            <div class="ticket-main">
                <div class="ticket-title">@fc.PeliculaTitulo</div>
                <div class="ticket-info">
                    @fc.Fecha.ToString("dd/MM/yyyy") @fc.Hora.ToString("HH:mm") · Sala @fc.SalaNombre
                    · Asientos: @string.Join(", ", fc.Asientos)
                </div>
                <div class="poster-meta mt-1">Comprado el @fc.UltimaCompra.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
            <div class="ticket-stub">S/ @fc.Total</div>
        </div>
    }
}