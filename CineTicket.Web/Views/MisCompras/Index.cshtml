@model List<Venta>
@{
    ViewData["Title"] = "Mis boletos";
}
<h1 class="display-font" style="font-size:2.2rem;">Mis boletos</h1>

@if (!Model.Any())
{
    <p class="text-muted mt-3">Aún no tienes compras registradas.</p>
    <a asp-controller="Cartelera" asp-action="Index" class="btn btn-primary">Ver cartelera</a>
}
else
{
    @foreach (var venta in Model)
    {
        <div class="mb-4">
            <div class="poster-meta mb-2">COMPRA #@venta.IdVenta · @venta.FechaVenta.ToString("dd/MM/yyyy HH:mm")</div>
            @foreach (var d in venta.DetalleVenta)
            {
                <div class="ticket">
                    <div class="ticket-main">
                        <div class="ticket-title">@d.IdFuncionNavigation.IdPeliculaNavigation.Titulo</div>
                        <div class="ticket-info">
                            @d.IdFuncionNavigation.Fecha.ToString("dd/MM/yyyy") @d.IdFuncionNavigation.Hora.ToString("HH:mm")
                            · Sala @d.IdFuncionNavigation.IdSalaNavigation.Nombre
                            · Asiento @d.IdAsientoNavigation.Fila@d.IdAsientoNavigation.Numero
                        </div>
                    </div>
                    <div class="ticket-stub">S/ @d.Precio</div>
                </div>
            }
        </div>
    }
}