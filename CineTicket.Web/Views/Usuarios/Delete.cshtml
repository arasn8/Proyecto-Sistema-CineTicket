@model Usuario
@{
    ViewData["Title"] = "Desactivar Usuario";
}
<h2>¿Desactivar a @Model.Nombres @Model.Apellidos?</h2>
<p class="text-muted">@Model.Correo — @Model.IdRolNavigation?.NombreRol</p>
<form asp-action="Delete" asp-route-id="@Model.IdUsuario" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Sí, desactivar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>