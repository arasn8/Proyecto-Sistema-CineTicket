@using Microsoft.AspNetCore.Mvc.Rendering
@model Usuario
@{
    ViewData["Title"] = "Editar Usuario";
}
<h2>Editar usuario</h2>
<form asp-action="Edit" asp-route-id="@Model.IdUsuario" method="post" style="max-width:500px">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="IdUsuario" />
    <input type="hidden" asp-for="Clave" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label class="form-label">Nombres</label>
        <input asp-for="Nombres" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Apellidos</label>
        <input asp-for="Apellidos" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Correo</label>
        <input asp-for="Correo" type="email" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Rol</label>
        <select asp-for="IdRol" class="form-select" asp-items="@(new SelectList(ViewBag.Roles, "IdRol", "NombreRol"))" required></select>
    </div>
    <div class="form-check mb-3">
        <input asp-for="Estado" class="form-check-input" type="checkbox" />
        <label class="form-check-label">Activo</label>
    </div>
    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>