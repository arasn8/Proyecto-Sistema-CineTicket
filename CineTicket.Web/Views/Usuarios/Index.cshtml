@model List<Usuario>
@{
    ViewData["Title"] = "Usuarios";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Usuarios</h2>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo usuario</a>
</div>
<table class="table table-striped">
    <thead><tr><th>Nombre</th><th>Correo</th><th>Rol</th><th>Estado</th><th></th></tr></thead>
    <tbody>
    @foreach (var u in Model)
    {
        <tr>
            <td>@u.Nombres @u.Apellidos</td>
            <td>@u.Correo</td>
            <td>@u.IdRolNavigation?.NombreRol</td>
            <td>@(u.Estado ? "Activo" : "Inactivo")</td>
            <td class="text-end">
                <a asp-action="Edit" asp-route-id="@u.IdUsuario" class="btn btn-sm btn-outline-secondary">Editar</a>
                <a asp-action="Delete" asp-route-id="@u.IdUsuario" class="btn btn-sm btn-outline-danger">Desactivar</a>
            </td>
        </tr>
    }
    </tbody>
</table>