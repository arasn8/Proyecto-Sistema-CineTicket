@model Funcione
@{
    ViewData["Title"] = "Eliminar Función";
}
<h2>¿Eliminar esta función?</h2>
<div class="card" style="max-width:500px">
    <div class="card-body">
        <h5 class="card-title">@Model.IdPeliculaNavigation?.Titulo</h5>
        <p class="card-text">@Model.IdSalaNavigation?.Nombre — @Model.Fecha.ToString("dd/MM/yyyy") @Model.Hora.ToString("HH:mm")</p>
    </div>
</div>
<form asp-action="Delete" asp-route-id="@Model.IdFuncion" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>