@model Venta
@{
    ViewData["Title"] = "Compra confirmada";
}
<div class="text-center mb-4">
    <div class="badge-genre mb-2" style="font-size:0.9rem;">COMPRA CONFIRMADA</div>
    <h1 class="display-font" style="font-size:2.6rem;">¡Disfruta tu función!</h1>
    <p class="poster-meta">N° DE VENTA @Model.IdVenta · TOTAL S/ @Model.Total</p>
</div>

<div class="mt-4">
@foreach (var d in Model.DetalleVenta)
{
    <div class="ticket">
        <div class="ticket-main">
            <div class="ticket-title">@d.IdFuncionNavigation.IdPeliculaNavigation.Titulo</div>
            <div class="ticket-info">Asiento @d.IdAsientoNavigation.Fila@d.IdAsientoNavigation.Numero</div>
        </div>
        <div class="ticket-stub">S/ @d.Precio</div>
    </div>
}
</div>

<div class="text-center mt-4">
    <a asp-controller="Cartelera" asp-action="Index" class="btn btn-primary">Volver a la cartelera</a>
</div>