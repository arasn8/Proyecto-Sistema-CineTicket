@model List<CarritoItem>
@{
    ViewData["Title"] = "Mi Carrito";
}
<h1 class="display-font" style="font-size:2.4rem;">Mi carrito</h1>

@if (!Model.Any())
{
    <p class="text-muted mt-3">Tu carrito está vacío.</p>
    <a asp-controller="Cartelera" asp-action="Index" class="btn btn-primary">Ver cartelera</a>
}
else
{
    <div class="mt-4" id="listaCarrito">
    @foreach (var item in Model)
    {
        <div class="ticket" id="item-@item.IdFuncion-@item.IdAsiento">
            <div class="ticket-main d-flex justify-content-between align-items-center">
                <div>
                    <div class="ticket-title">@item.PeliculaTitulo</div>
                    <div class="ticket-info">@item.Fecha.ToString("dd/MM/yyyy") @item.Hora.ToString("HH:mm") · @item.SalaNombre · Asiento @item.AsientoNombre</div>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="ticket-price">S/ @item.Precio</div>
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="quitarDelCarrito(@item.IdFuncion, @item.IdAsiento)">Quitar</button>
                </div>
            </div>
            <div class="ticket-stub">CINE<br />TICKET</div>
        </div>
    }
    </div>

    <div class="d-flex justify-content-between align-items-center mt-4 pt-3" style="border-top:2px solid var(--line)">
        <span class="display-font" style="font-size:1.6rem;">Total</span>
        <span class="ticket-price" id="totalCarrito" style="font-size:1.6rem;">S/ @ViewBag.Total</span>
    </div>

    <form asp-action="Confirmar" method="post" class="mt-3">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-success w-100 py-2">Confirmar compra</button>
    </form>
}

@section Scripts {
<script>
    async function quitarDelCarrito(idFuncion, idAsiento) {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const body = new URLSearchParams({ idFuncion, idAsiento });

        const res = await fetch('@Url.Action("EliminarAjax", "Carrito")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
            body
        });
        const data = await res.json();

        if (data.success) {
            document.getElementById(`item-${idFuncion}-${idAsiento}`)?.remove();
            document.getElementById('totalCarrito').textContent = `S/ ${data.total}`;
            mostrarToast('Asiento quitado del carrito.', 'success');
            if (data.cantidad === 0) setTimeout(() => location.reload(), 700);
        }
    }
</script>
}